<Window x:Class="SteamToolkitMRM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/SteamToolkitMRM;component/Assets/SteamToolkitMRM.ico"
        Title="Steam Toolkit MRM" Width="1120" Height="760"
        MinWidth="940" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="18,22">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,2,0,32">
                        <Border Width="38" Height="38" CornerRadius="11" Background="#302449">
                            <TextBlock Text="S" Foreground="{DynamicResource AccentBrush}" FontSize="23"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,1,0,0" VerticalAlignment="Center">
                            <TextBlock Text="STEAM TOOLKIT" FontWeight="Bold" FontSize="12" Foreground="#AFC2E5"/>
                            <TextBlock Text="MRM" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="ESPAÇO DE TRABALHO" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}" Margin="8,0,0,10"/>
                    <Button x:Name="BackupsNav" Click="BackupsNav_Click" HorizontalContentAlignment="Left"
                            Background="#263756" BorderBrush="#314B73" Padding="12,11" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣" Foreground="{DynamicResource AccentBrush}" FontSize="17" Width="27"/>
                            <TextBlock Text="Backups" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNav" Click="SettingsNav_Click" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderBrush="Transparent" Padding="12,11">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Foreground="{StaticResource MutedBrush}" FontSize="16" Width="27"/>
                            <TextBlock Text="Definições" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="2,18,2,0">
                    <Border Background="#10192A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource GreenBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="SteamStatusText" Text="A verificar Steam..." FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <TextBlock Text="A monitorização automática funciona enquanto a aplicação estiver aberta."
                                       TextWrapping="Wrap" FontSize="10" Foreground="#74839B" LineHeight="15"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="STEAM TOOLKIT MRM  ·  WINDOWS" FontSize="9" Foreground="#65738A"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30,25,30,20">
            <Grid x:Name="BackupsView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,2,0,22">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="OpenLudusaviButton" Click="OpenLudusavi_Click" Margin="0,0,8,0"
                                Background="Transparent" BorderBrush="{StaticResource BorderBrush}" Padding="12,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↗" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Abrir Ludusavi"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenFolderButton" Click="OpenFolder_Click"
                                Background="Transparent" BorderBrush="{StaticResource BorderBrush}" Padding="12,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Abrir pasta"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Os teus backups" FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="Guarda e restaura os dados da tua biblioteca Steam e Lua Tools."
                                   Foreground="{StaticResource MutedBrush}" Margin="1,5,0,0"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Background="#211B35" BorderBrush="#3D3159" BorderThickness="1"
                        CornerRadius="12" Padding="18" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Protege o teu progresso" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Inclui userdata, estatísticas, depotcache e st-plug-in."
                                       Foreground="#C5B9DC" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button x:Name="CreateBackupButton" Grid.Column="1" Click="CreateBackup_Click"
                                Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                Foreground="#08101E" Padding="17,11" MinWidth="150">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="＋" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" Margin="0,0,7,0"/>
                                <TextBlock Text="Criar backup"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Histórico de backups" FontSize="16" FontWeight="SemiBold"/>
                        <Border Background="#202D43" CornerRadius="10" Padding="8,3" Margin="10,0,0,0">
                            <TextBlock x:Name="BackupCountText" Text="0" FontSize="11" Foreground="#C3D0E4"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Click="Refresh_Click" Background="Transparent" BorderBrush="Transparent"
                            Foreground="{StaticResource MutedBrush}" Padding="9,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" FontSize="17" Margin="0,0,6,0"/>
                            <TextBlock Text="Atualizar"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="10">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="BackupList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}" BorderBrush="#26354D"
                                                BorderThickness="1" CornerRadius="9" Padding="13" Margin="2,2,2,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   FontSize="13" TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="440"/>
                                                        <TextBlock Text="  ◆" Foreground="{DynamicResource AccentBrush}"
                                                                   Visibility="{Binding Pinned, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DateLabel}" Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11" Margin="0,5,0,0"/>
                                                    <TextBlock Text="{Binding SizeLabel}" Foreground="#7788A2"
                                                               FontSize="10" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Button Content="{Binding Pinned, Converter={StaticResource PinLabelConverter}}"
                                                            Tag="{Binding}" Click="PinBackup_Click" Margin="0,0,6,0"
                                                            Padding="9,7" FontSize="11"/>
                                                    <Button Content="Renomear" Tag="{Binding}" Click="RenameBackup_Click"
                                                            Margin="0,0,6,0" Padding="9,7" FontSize="11"/>
                                                    <Button Content="Restaurar" Tag="{Binding}" Click="RestoreBackup_Click"
                                                            Background="#35264D" BorderBrush="#644A91"
                                                            Margin="0,0,6,0" Padding="10,7" FontSize="11"/>
                                                    <Button Content="Apagar" Tag="{Binding}" Click="DeleteBackup_Click"
                                                            Background="#3A222C" BorderBrush="#5E3443"
                                                            Foreground="#F6A7B2" Padding="9,7" FontSize="11"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="Ainda não há backups" FontSize="17" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Cria o primeiro backup ou inicia um jogo com a monitorização ativa."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock x:Name="FooterText" Grid.Row="4" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="3,9,0,0"/>
            </Grid>

            <Grid x:Name="SettingsView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,2,0,22">
                    <TextBlock Text="Definições" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Configura o comportamento e o local de armazenamento."
                               Foreground="{StaticResource MutedBrush}" Margin="1,5,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Automação" FontSize="15" FontWeight="SemiBold"/>
                                <CheckBox x:Name="AutoBackupOnStartCheckBox"
                                          Content="Criar backup automaticamente quando um jogo iniciar"
                                          Margin="0,16,0,8"/>
                                <CheckBox x:Name="AutoBackupOnCloseCheckBox"
                                          Content="Criar backup automaticamente quando um jogo fechar"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="A monitorização usa o estado de execução da Steam e só funciona enquanto esta aplicação estiver aberta."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                                           Margin="23,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Arranque do Windows" FontSize="15" FontWeight="SemiBold"/>
                                <CheckBox x:Name="StartWithWindowsCheckBox" Content="Executar com o Windows"
                                          Margin="0,16,0,8"/>
                                <CheckBox x:Name="StartMinimizedToTrayCheckBox"
                                          Content="Iniciar minimizado na bandeja do sistema"
                                          Margin="0,0,0,4"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Idioma" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Idioma da aplicação" Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" Margin="0,8,0,8"/>
                                <ComboBox x:Name="LanguageComboBox" Width="220" HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Português"/>
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Español"/>
                                    <ComboBoxItem Content="Русский"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Aparência" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Escolhe uma cor na grelha ou escreve o seu código hexadecimal."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="AccentPickerButton" Click="AccentPicker_Click"
                                            Width="34" Height="34" Padding="0" Margin="0,0,10,0"
                                            Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                                            ToolTip="Clica para abrir a grelha de cores">
                                        <Border x:Name="AccentPreview" Width="24" Height="24" CornerRadius="5"
                                                Background="{DynamicResource AccentBrush}"/>
                                    </Button>
                                    <TextBox x:Name="PrimaryColorTextBox" Width="125" MaxLength="7"
                                             VerticalContentAlignment="Center" TextChanged="PrimaryColorTextChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Armazenamento" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Pasta dos backups (deixa vazio para usar a pasta backups junto da aplicação)"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BackupPathTextBox" VerticalContentAlignment="Center"
                                             ToolTip="Caminho completo da pasta onde os backups novos serão guardados"/>
                                    <Button Grid.Column="1" Content="Escolher..." Click="BrowseBackupPath_Click"
                                            Margin="8,0,0,0"/>
                                    <Button Grid.Column="2" Content="Padrão" Click="DefaultBackupPath_Click"
                                            Margin="8,0,0,0" Background="Transparent"/>
                                </Grid>
                                <TextBlock x:Name="BackupPathDescription"
                                           Text="O caminho será usado a partir do próximo backup."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Histórico" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Limite de backups automáticos e manuais não fixados"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,10"/>
                                <TextBox x:Name="BackupLimitTextBox" Width="100" HorizontalAlignment="Left"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="Backups fixados são preservados mesmo quando o limite é atingido."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="SaveSettingsButton" Content="Guardar definições" Click="SaveSettings_Click"
                                Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                Foreground="#08101E" HorizontalAlignment="Right" Padding="18,11"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
