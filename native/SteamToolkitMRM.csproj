<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SteamToolkitMRM</AssemblyName>
    <RootNamespace>SteamToolkitMRM</RootNamespace>
    <ApplicationIcon>Assets\SteamToolkitMRM.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\SteamToolkitMRM.ico"/>
    <Resource Include="Assets\SteamToolkitMRM_largest.png">
      <LogicalName>Assets\SteamToolkitMRM_largest.png</LogicalName>
    </Resource>
  </ItemGroup>
</Project>
